generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ==============================
// USER MODEL (GOOGLE AUTH)
// ==============================
//

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  onboarded     Boolean   @default(true)

  accounts      Account[]
  sessions      Session[]
  interviews    Interview[]
  settings      UserSettings?
  transactions  Transaction[]
  subscriptions Subscription[]
}

//
// ==============================
// INTERVIEW MODEL
// ==============================
//

model Interview {
  id             String   @id @default(cuid())
  userId         String
  sessionId      String   @default(cuid())
  resumeData     String
  jobDescription String
  questions      String[]
  answers        String[]
  analysis       String?
  interviewOpen  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//
// ==============================
// USER SETTINGS (CREDITS SYSTEM)
// ==============================
//

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  credits          Int @default(5) // 🎁 free credits
  totalUsedCredits Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//
// ==============================
// TRANSACTIONS (PAYMENTS / CREDIT LOG)
// ==============================
//

model Transaction {
  id     String @id @default(cuid())
  userId String

  type    TransactionType
  credits Int
  amount  Float?
  status  TransactionStatus

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TransactionType {
  FREE
  PURCHASE
}

enum TransactionStatus {
  SUCCESS
  FAILED
}

//
// ==============================
// SUBSCRIPTION (OPTIONAL FUTURE)
// ==============================
//

model Subscription {
  id     String @id @default(cuid())
  userId String

  plan    String
  credits Int

  startDate DateTime
  endDate   DateTime?
  status    SubscriptionStatus

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

//
// ==============================
// NEXTAUTH MODELS
// ==============================
//

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
